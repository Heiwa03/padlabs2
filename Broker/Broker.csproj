<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.*" />
    <Protobuf Include="..\protos\broker.proto" GrpcServices="Server" ProtoRoot="..\protos" />
    <Protobuf Include="..\protos\events.proto" GrpcServices="None" ProtoRoot="..\protos" />
  </ItemGroup>
</Project>
